# TechStore SPT — site-spt (npm). Repositório Git esperado: Site_SPT no GitHub.
# Copie para .env.local (não commite segredos).
# Neon: Dashboard → Connection string (pooling recomendado para serverless).
# Supabase: Settings → Database → URI (modo session ou pooler).

DATABASE_URL="postgresql://usuario:senha@host/db?sslmode=require"

# Opcional: PIN para proteger /vendedor/* (middleware). Se vazio, painel aberto (só para dev).
VENDEDOR_PIN=""
